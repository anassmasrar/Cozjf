rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 80 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidStudioProject(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 80 &&
             data.geometryMode is string &&
             data.geometryMode in ['SMOOTH_ORGANIQUE', 'VOXEL_MODULAIRE'] &&
             data.renderEngine is string &&
             data.renderEngine in ['POLYX3D_MOBILE', 'AAA_REALISME'] &&
             data.nodeCount is int &&
             data.nodeCount >= 0 &&
             data.nodeCount <= 10000 &&
             data.keyframeCount is int &&
             data.keyframeCount >= 0 &&
             data.keyframeCount <= 10000 &&
             data.sceneSummary is string &&
             data.sceneSummary.size() <= 32000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /projects/{projectId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(projectId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(projectId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll(['userId', 'name', 'geometryMode', 'renderEngine', 'nodeCount', 'keyframeCount', 'sceneSummary', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'geometryMode', 'renderEngine', 'nodeCount', 'keyframeCount', 'sceneSummary', 'createdAt', 'updatedAt']) &&
                         isValidStudioProject(incoming(), userId);

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(projectId) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidStudioProject(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'geometryMode', 'renderEngine', 'nodeCount', 'keyframeCount', 'sceneSummary', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(projectId) && request.auth.uid == userId;
      }
    }
  }
}
